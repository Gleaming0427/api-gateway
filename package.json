{
  "name": "@armored1486/api-gateway-core",
  "version": "2.0.2",
  "publishConfig": {
    "access": "public"
  },
  "author": "Julien Chapron <jigsaw_culpable558@simplelogin.com>",
  "description": "Serverless-native API Gateway core — rate limiting, JWT auth, typed errors for B2B SaaS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gleaming0427/api-gateway.git"
  },
  "homepage": "https://github.com/Gleaming0427/api-gateway#readme",
  "bugs": "https://github.com/Gleaming0427/api-gateway/issues",
  "keywords": [
    "api-gateway",
    "rate-limiting",
    "jwt",
    "token-bucket",
    "serverless",
    "aws",
    "sst",
    "b2b-saas"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate-keys": "bash scripts/generate-keys.sh",
    "dev-jwks": "npx tsx scripts/dev-jwks-server.ts",
    "generate-token": "npx tsx scripts/generate-token.ts"
  },
  "dependencies": {
    "jose": "5.10.0",
    "zod": "3.24.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "3.700.0",
    "@aws-sdk/lib-dynamodb": "3.700.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/lib-dynamodb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.3.0",
    "sst": "^4.14.1",
    "tsx": "^4.22.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.0.0"
  }
}
